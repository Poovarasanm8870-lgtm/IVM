# ==========================================
# Git Ignore for Inventory Management System
# ==========================================

# Environments & Virtual Environments
venv/
env/
ENV/
.venv/
*/venv/
*/env/

# Environment Secrets & Sensitive Data
.env
.env.*
!.env.example
*.pem
*.key

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Database & SQLite files
*.sqlite3
*.db
db.sqlite3
Backend/db.sqlite3

# Static & Uploaded Media
Backend/staticfiles/
staticfiles/
Backend/media/
media/
*.log

# Node & Frontend dependencies & builds
node_modules/
Frontend/node_modules/
Frontend/dist/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Deployment & Package Archives
*.zip
*.tar.gz
*.tgz
*.rar
*deploy*
package_deploy.py
IVM_deploy.zip

# OS & Editor Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
